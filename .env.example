# Конфигурация окружения для PromptFlow
# Скопируйте этот файл в .env и заполните реальными значениями.
# Не добавляйте .env в систему контроля версий.

# Режим работы Flask: development | testing | production
FLASK_ENV=development
FLASK_APP=app:create_app

# Секретный ключ Flask (обязательно смените на своё значение в production!)
SECRET_KEY=dev-secret-key-change-me

# Строка подключения к базе данных (PostgreSQL)
DATABASE_URL=DATABASE_URL=postgresql+psycopg2://promptflow:promptflow@localhost:5432/promptflow

# Переменные для Docker Compose (сервис db)
POSTGRES_USER=promptflow
POSTGRES_PASSWORD=promptflow
POSTGRES_DB=promptflow
